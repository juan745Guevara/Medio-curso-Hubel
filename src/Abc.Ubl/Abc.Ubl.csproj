<Project Sdk="Microsoft.NET.Sdk">
  <!-- Classes generated from the official OASIS UBL 2.1 XSD (ADR 0005). Only Generated/ (never edited)
       and Customizations/ (partial classes with SUNAT serialization details). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591;CS0108;CS0114</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
