<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage of the hand-written code: the classes generated from the XSD (Abc.Ubl) and the tests are excluded. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <Format>Cobertura</Format>
          <CodeCoverage>
            <ModulePaths>
              <Include>
                <ModulePath>.*Abc\.Invoicing\.Domain\.dll$</ModulePath>
                <ModulePath>.*Abc\.Invoicing\.Application\.dll$</ModulePath>
                <ModulePath>.*Abc\.Invoicing\.Infrastructure\.dll$</ModulePath>
              </Include>
            </ModulePaths>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
