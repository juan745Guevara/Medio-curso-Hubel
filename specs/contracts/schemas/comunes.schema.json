{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/schemas/comunes.schema.json",
  "title": "Tipos comunes",
  "description": "Value objects compartidos. Códigos según Anexo 8 de SUNAT.",
  "$defs": {
    "Ruc": {
      "type": "string",
      "pattern": "^(10|15|16|17|20)[0-9]{9}$",
      "description": "RUC. Además valida dígito verificador módulo 11 (regla de negocio, RF-02)."
    },
    "TipoDocumentoIdentidad": {
      "type": "string",
      "enum": [
        "0",
        "1",
        "4",
        "6",
        "7",
        "A",
        "B"
      ],
      "description": "Catálogo 06"
    },
    "DocumentoIdentidad": {
      "type": "object",
      "required": [
        "tipo",
        "numero"
      ],
      "properties": {
        "tipo": {
          "$ref": "#/$defs/TipoDocumentoIdentidad"
        },
        "numero": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "6"
              }
            }
          },
          "then": {
            "properties": {
              "numero": {
                "$ref": "#/$defs/Ruc"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "1"
              }
            }
          },
          "then": {
            "properties": {
              "numero": {
                "pattern": "^[0-9]{8}$"
              }
            }
          }
        }
      ]
    },
    "TipoComprobante": {
      "type": "string",
      "enum": [
        "01",
        "03",
        "07",
        "08"
      ],
      "description": "Catálogo 01: 01 factura, 03 boleta, 07 nota de crédito, 08 nota de débito"
    },
    "Serie": {
      "type": "string",
      "pattern": "^[FB][A-Z0-9]{3}$"
    },
    "Correlativo": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99999999
    },
    "NumeroDocumento": {
      "type": "string",
      "pattern": "^[FB][A-Z0-9]{3}-[0-9]{1,8}$"
    },
    "Moneda": {
      "type": "string",
      "enum": [
        "PEN",
        "USD"
      ],
      "description": "Catálogo 02 (ISO 4217)"
    },
    "Importe": {
      "type": "string",
      "pattern": "^-?[0-9]{1,12}(\\.[0-9]{1,2})?$",
      "description": "Decimal exacto como texto, 2 decimales. Nunca número binario."
    },
    "ImporteUnitario": {
      "type": "string",
      "pattern": "^[0-9]{1,12}(\\.[0-9]{1,10})?$",
      "description": "Hasta 10 decimales"
    },
    "Cantidad": {
      "type": "string",
      "pattern": "^[0-9]{1,12}(\\.[0-9]{1,10})?$"
    },
    "UnidadMedida": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,3}$",
      "description": "Catálogo 03, UN/ECE Rec 20 (NIU, KGM, LTR, ZZ…)"
    },
    "AfectacionIgv": {
      "type": "string",
      "enum": [
        "10",
        "11",
        "12",
        "13",
        "14",
        "15",
        "16",
        "17",
        "20",
        "21",
        "30",
        "31",
        "32",
        "33",
        "34",
        "35",
        "36",
        "37",
        "40"
      ],
      "description": "Catálogo 07"
    },
    "SistemaIsc": {
      "type": "string",
      "enum": [
        "01",
        "02",
        "03"
      ],
      "description": "Catálogo 08: 01 al valor, 02 monto fijo, 03 precio de venta al público"
    },
    "TipoOperacion": {
      "type": "string",
      "enum": [
        "0101"
      ],
      "description": "Catálogo 51, alcance actual: venta interna"
    },
    "EstadoSunat": {
      "type": "string",
      "enum": [
        "BORRADOR",
        "VALIDADO",
        "FIRMADO",
        "ENVIADO",
        "ACEPTADO",
        "OBSERVADO",
        "RECHAZADO",
        "PENDIENTE_REENVIO",
        "DADO_DE_BAJA"
      ]
    },
    "Fecha": {
      "type": "string",
      "format": "date"
    },
    "Cuota": {
      "type": "object",
      "required": [
        "monto",
        "fechaVencimiento"
      ],
      "properties": {
        "monto": {
          "$ref": "#/$defs/Importe"
        },
        "fechaVencimiento": {
          "$ref": "#/$defs/Fecha"
        }
      },
      "additionalProperties": false
    },
    "FormaPago": {
      "type": "object",
      "required": [
        "tipo"
      ],
      "properties": {
        "tipo": {
          "enum": [
            "Contado",
            "Credito"
          ]
        },
        "montoPendiente": {
          "$ref": "#/$defs/Importe"
        },
        "cuotas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Cuota"
          }
        }
      },
      "if": {
        "properties": {
          "tipo": {
            "const": "Credito"
          }
        }
      },
      "then": {
        "required": [
          "montoPendiente",
          "cuotas"
        ],
        "properties": {
          "cuotas": {
            "minItems": 1
          }
        }
      },
      "additionalProperties": false
    },
    "Adquirente": {
      "type": "object",
      "required": [
        "documento",
        "nombre"
      ],
      "properties": {
        "documento": {
          "$ref": "#/$defs/DocumentoIdentidad"
        },
        "nombre": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "direccion": {
          "type": "string",
          "maxLength": 200
        },
        "correo": {
          "type": "string",
          "format": "email"
        }
      },
      "additionalProperties": false
    }
  }
}
