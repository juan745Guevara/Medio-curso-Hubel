{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/schemas/item.schema.json",
  "title": "ItemDTO",
  "description": "Document line. Taxes are calculated by the system (FR-05); the client does not send them.",
  "type": "object",
  "required": [
    "productCode",
    "quantity",
    "unit",
    "unitValue"
  ],
  "properties": {
    "productCode": {
      "type": "string",
      "maxLength": 30
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "Taken from the Product if omitted"
    },
    "quantity": {
      "$ref": "common.schema.json#/$defs/Quantity"
    },
    "unit": {
      "$ref": "common.schema.json#/$defs/UnitOfMeasure"
    },
    "unitValue": {
      "$ref": "common.schema.json#/$defs/UnitAmount",
      "description": "Excluding taxes"
    },
    "discount": {
      "$ref": "common.schema.json#/$defs/Amount"
    }
  },
  "additionalProperties": false
}
