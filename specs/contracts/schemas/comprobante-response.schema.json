{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/schemas/comprobante-response.schema.json",
  "title": "DocumentoElectronicoResponse",
  "type": "object",
  "required": [
    "id",
    "tipo",
    "numero",
    "fechaEmision",
    "moneda",
    "estado",
    "totales",
    "items"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tipo": {
      "$ref": "comunes.schema.json#/$defs/TipoComprobante"
    },
    "numero": {
      "$ref": "comunes.schema.json#/$defs/NumeroDocumento"
    },
    "fechaEmision": {
      "$ref": "comunes.schema.json#/$defs/Fecha"
    },
    "moneda": {
      "$ref": "comunes.schema.json#/$defs/Moneda"
    },
    "estado": {
      "$ref": "comunes.schema.json#/$defs/EstadoSunat"
    },
    "fechaLimiteEnvio": {
      "$ref": "comunes.schema.json#/$defs/Fecha"
    },
    "totales": {
      "type": "object",
      "required": [
        "gravado",
        "exonerado",
        "inafecto",
        "igv",
        "isc",
        "icbper",
        "descuentos",
        "importeTotal"
      ],
      "properties": {
        "gravado": {
          "$ref": "comunes.schema.json#/$defs/Importe"
        },
        "exonerado": {
          "$ref": "comunes.schema.json#/$defs/Importe"
        },
        "inafecto": {
          "$ref": "comunes.schema.json#/$defs/Importe"
        },
        "igv": {
          "$ref": "comunes.schema.json#/$defs/Importe"
        },
        "isc": {
          "$ref": "comunes.schema.json#/$defs/Importe"
        },
        "icbper": {
          "$ref": "comunes.schema.json#/$defs/Importe"
        },
        "descuentos": {
          "$ref": "comunes.schema.json#/$defs/Importe"
        },
        "importeTotal": {
          "$ref": "comunes.schema.json#/$defs/Importe"
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "orden",
          "codigoProducto",
          "cantidad",
          "valorVenta",
          "igv",
          "isc",
          "icbper",
          "importe"
        ],
        "properties": {
          "orden": {
            "type": "integer"
          },
          "codigoProducto": {
            "type": "string"
          },
          "cantidad": {
            "$ref": "comunes.schema.json#/$defs/Cantidad"
          },
          "afectacionIgv": {
            "$ref": "comunes.schema.json#/$defs/AfectacionIgv"
          },
          "sistemaIsc": {
            "$ref": "comunes.schema.json#/$defs/SistemaIsc"
          },
          "valorVenta": {
            "$ref": "comunes.schema.json#/$defs/Importe"
          },
          "igv": {
            "$ref": "comunes.schema.json#/$defs/Importe"
          },
          "isc": {
            "$ref": "comunes.schema.json#/$defs/Importe"
          },
          "icbper": {
            "$ref": "comunes.schema.json#/$defs/Importe"
          },
          "importe": {
            "$ref": "comunes.schema.json#/$defs/Importe"
          }
        }
      }
    },
    "cdr": {
      "type": "object",
      "properties": {
        "codigo": {
          "type": "string"
        },
        "descripcion": {
          "type": "string"
        },
        "observaciones": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recibido": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "hashXml": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "enlaces": {
      "type": "object",
      "properties": {
        "pdf": {
          "type": "string",
          "format": "uri-reference"
        },
        "xml": {
          "type": "string",
          "format": "uri-reference"
        },
        "cdr": {
          "type": "string",
          "format": "uri-reference"
        }
      }
    }
  }
}
