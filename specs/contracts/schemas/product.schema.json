{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/schemas/product.schema.json",
  "title": "Product",
  "description": "Product of the Catalog context. Tax classification (Catalogs 07 and 08, ICBPER) for FR-05 and FR-36; PLE classification (Table 5, UNSPSC) for formats 12.1 (FR-40, FR-43).",
  "type": "object",
  "required": [
    "code",
    "description",
    "unit",
    "igvTreatment",
    "existenceType"
  ],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "maxLength": 24,
      "description": "Own code; PLE 12.1 field 7 (max 24)."
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "First 80 characters go to PLE 12.1 field 15."
    },
    "unit": {
      "$ref": "common.schema.json#/$defs/UnitOfMeasure"
    },
    "igvTreatment": {
      "$ref": "common.schema.json#/$defs/IgvTreatment"
    },
    "isc": {
      "type": "object",
      "required": [
        "system"
      ],
      "additionalProperties": false,
      "properties": {
        "system": {
          "$ref": "common.schema.json#/$defs/IscSystem"
        },
        "rate": {
          "type": "string",
          "pattern": "^[0-9]{1,3}(\\.[0-9]{1,4})?$",
          "description": "Percentage, systems 01 and 03"
        },
        "fixedAmount": {
          "$ref": "common.schema.json#/$defs/UnitAmount",
          "description": "Per unit, system 02"
        },
        "suggestedRetailPrice": {
          "$ref": "common.schema.json#/$defs/Amount",
          "description": "System 03: base = price × 0.847"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "system": {
                "const": "02"
              }
            }
          },
          "then": {
            "required": [
              "fixedAmount"
            ]
          },
          "else": {
            "required": [
              "rate"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "system": {
                "const": "03"
              }
            }
          },
          "then": {
            "required": [
              "suggestedRetailPrice"
            ]
          }
        }
      ]
    },
    "isPlasticBag": {
      "type": "boolean",
      "default": false,
      "description": "ICBPER (tax 7152)"
    },
    "existenceType": {
      "$ref": "common.schema.json#/$defs/Table5ExistenceType"
    },
    "unspscCode": {
      "type": "string",
      "pattern": "^[0-9]{8}$",
      "description": "UNSPSC code (Catalog 25) for cac:CommodityClassification and PLE 12.1 field 9."
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "PENDING_CLASSIFICATION"
      ],
      "readOnly": true
    }
  }
}
