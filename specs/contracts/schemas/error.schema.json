{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/schemas/error.schema.json",
  "title": "ErrorResponse",
  "description": "RFC 9457 Problem Details. Never exposes internal traces (constitution 16).",
  "type": "object",
  "required": [
    "type",
    "title",
    "status",
    "code"
  ],
  "properties": {
    "type": {
      "type": "string",
      "format": "uri-reference"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "integer"
    },
    "code": {
      "type": "string",
      "description": "Stable internal code, e.g. INVALID_RUC, INVOICE_REQUIRES_RUC, INVALID_XSD. Internal code → SUNAT errors table in traceability/regulatory-matrix.md §G"
    },
    "detail": {
      "type": "string"
    },
    "sunatCode": {
      "type": "string",
      "description": "CDR code when it comes from SUNAT/OSE"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
