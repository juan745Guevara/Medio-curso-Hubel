{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/schemas/lote-migracion-response.schema.json",
  "title": "LoteMigracionResponse",
  "type": "object",
  "required": [
    "id",
    "archivo",
    "hashArchivo",
    "filasLeidas",
    "migradas",
    "rechazadas",
    "duplicadas",
    "conciliado"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "archivo": {
      "type": "string"
    },
    "hashArchivo": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "filasLeidas": {
      "type": "integer"
    },
    "migradas": {
      "type": "integer"
    },
    "rechazadas": {
      "type": "integer"
    },
    "duplicadas": {
      "type": "integer"
    },
    "conciliado": {
      "type": "boolean",
      "description": "filasLeidas = migradas + rechazadas + duplicadas y saldos iguales (RF-34)"
    },
    "rechazos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fila",
          "motivo"
        ],
        "properties": {
          "fila": {
            "type": "integer"
          },
          "motivo": {
            "type": "string"
          }
        }
      }
    }
  }
}
