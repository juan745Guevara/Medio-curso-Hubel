{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/schemas/baja-request.schema.json",
  "title": "ComunicarBajaRequest",
  "description": "RF-23, RF-24",
  "type": "object",
  "required": [
    "documentos"
  ],
  "properties": {
    "documentos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tipo",
          "numero",
          "motivo"
        ],
        "properties": {
          "tipo": {
            "$ref": "comunes.schema.json#/$defs/TipoComprobante"
          },
          "numero": {
            "$ref": "comunes.schema.json#/$defs/NumeroDocumento"
          },
          "motivo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
