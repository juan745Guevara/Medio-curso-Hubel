{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/schemas/note-request.schema.json",
  "title": "IssueNoteRequest",
  "description": "Credit note (07, cat. 09) or debit note (08, cat. 10). FR-18 to FR-22.",
  "type": "object",
  "required": [
    "type",
    "series",
    "modifiedDocument",
    "reason",
    "items"
  ],
  "properties": {
    "type": {
      "enum": [
        "07",
        "08"
      ]
    },
    "series": {
      "$ref": "common.schema.json#/$defs/Series"
    },
    "modifiedDocument": {
      "type": "object",
      "required": [
        "type",
        "number"
      ],
      "properties": {
        "type": {
          "enum": [
            "01",
            "03"
          ]
        },
        "number": {
          "$ref": "common.schema.json#/$defs/DocumentNumber"
        }
      },
      "additionalProperties": false
    },
    "reason": {
      "type": "object",
      "required": [
        "code",
        "description"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[0-9]{2}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "item.schema.json"
      }
    },
    "paymentTerms": {
      "$ref": "common.schema.json#/$defs/PaymentTerms"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "07"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "properties": {
              "code": {
                "enum": [
                  "01",
                  "02",
                  "03",
                  "04",
                  "05",
                  "06",
                  "07",
                  "08",
                  "09",
                  "10",
                  "13"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "08"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "properties": {
              "code": {
                "enum": [
                  "01",
                  "02",
                  "03"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
