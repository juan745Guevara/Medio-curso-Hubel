{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/schemas/common.schema.json",
  "title": "Common types",
  "description": "Shared value objects. Codes per SUNAT Annex 8.",
  "$defs": {
    "Ruc": {
      "type": "string",
      "pattern": "^(10|15|16|17|20)[0-9]{9}$",
      "description": "RUC. The modulo-11 check digit is also validated (business rule, FR-02)."
    },
    "IdentityDocumentType": {
      "type": "string",
      "enum": [
        "0",
        "1",
        "4",
        "6",
        "7",
        "A",
        "B"
      ],
      "description": "Catalog 06"
    },
    "IdentityDocument": {
      "type": "object",
      "required": [
        "type",
        "number"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/IdentityDocumentType"
        },
        "number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "6"
              }
            }
          },
          "then": {
            "properties": {
              "number": {
                "$ref": "#/$defs/Ruc"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "1"
              }
            }
          },
          "then": {
            "properties": {
              "number": {
                "pattern": "^[0-9]{8}$"
              }
            }
          }
        }
      ]
    },
    "DocumentType": {
      "type": "string",
      "enum": [
        "01",
        "03",
        "07",
        "08"
      ],
      "description": "Catalog 01: 01 invoice, 03 sales receipt, 07 credit note, 08 debit note"
    },
    "Series": {
      "type": "string",
      "pattern": "^[FB][A-Z0-9]{3}$"
    },
    "SequenceNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99999999
    },
    "DocumentNumber": {
      "type": "string",
      "pattern": "^[FB][A-Z0-9]{3}-[0-9]{1,8}$"
    },
    "Currency": {
      "type": "string",
      "enum": [
        "PEN",
        "USD"
      ],
      "description": "Catalog 02 (ISO 4217)"
    },
    "Amount": {
      "type": "string",
      "pattern": "^-?[0-9]{1,12}(\\.[0-9]{1,2})?$",
      "description": "Exact decimal as text, 2 decimals. Never a binary number."
    },
    "UnitAmount": {
      "type": "string",
      "pattern": "^[0-9]{1,12}(\\.[0-9]{1,10})?$",
      "description": "Up to 10 decimals"
    },
    "Quantity": {
      "type": "string",
      "pattern": "^[0-9]{1,12}(\\.[0-9]{1,10})?$"
    },
    "UnitOfMeasure": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,3}$",
      "description": "Catalog 03, UN/ECE Rec 20 (NIU, KGM, LTR, ZZ…)"
    },
    "IgvTreatment": {
      "type": "string",
      "enum": [
        "10",
        "11",
        "12",
        "13",
        "14",
        "15",
        "16",
        "17",
        "20",
        "21",
        "30",
        "31",
        "32",
        "33",
        "34",
        "35",
        "36",
        "37",
        "40"
      ],
      "description": "Catalog 07"
    },
    "IscSystem": {
      "type": "string",
      "enum": [
        "01",
        "02",
        "03"
      ],
      "description": "Catalog 08: 01 ad valorem, 02 fixed amount, 03 retail sale price"
    },
    "OperationType": {
      "type": "string",
      "enum": [
        "0101"
      ],
      "description": "Catalog 51, current scope: domestic sale"
    },
    "SunatStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "VALIDATED",
        "SIGNED",
        "SENT",
        "ACCEPTED",
        "OBSERVED",
        "REJECTED",
        "PENDING_RESEND",
        "VOIDED"
      ]
    },
    "Date": {
      "type": "string",
      "format": "date"
    },
    "Installment": {
      "type": "object",
      "required": [
        "amount",
        "dueDate"
      ],
      "properties": {
        "amount": {
          "$ref": "#/$defs/Amount"
        },
        "dueDate": {
          "$ref": "#/$defs/Date"
        }
      },
      "additionalProperties": false
    },
    "PaymentTerms": {
      "type": "object",
      "required": [
        "type"
      ],
      "description": "In the XML SUNAT requires the literal values 'Contado' / 'Credito'.",
      "properties": {
        "type": {
          "enum": [
            "CASH",
            "CREDIT"
          ]
        },
        "outstandingAmount": {
          "$ref": "#/$defs/Amount"
        },
        "installments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Installment"
          }
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "CREDIT"
          }
        }
      },
      "then": {
        "required": [
          "outstandingAmount",
          "installments"
        ],
        "properties": {
          "installments": {
            "minItems": 1
          }
        }
      },
      "additionalProperties": false
    },
    "Buyer": {
      "type": "object",
      "required": [
        "document",
        "name"
      ],
      "properties": {
        "document": {
          "$ref": "#/$defs/IdentityDocument"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "address": {
          "type": "string",
          "maxLength": 200
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      },
      "additionalProperties": false
    }
  }
}
